# Copia este archivo como .env y ajusta los valores.
#   Windows:  copy .env.example .env

# Clave para firmar los tokens JWT (CU-01).
# En produccion debe ser larga, aleatoria y secreta.
CATTLEYA_SECRET_KEY=cambia-esta-clave-en-produccion

# Minutos de vigencia del token de sesion
CATTLEYA_TOKEN_EXPIRE_MINUTES=480

# Cadena de conexion a la base de datos.
# SQLite (por defecto, no requiere instalacion):
CATTLEYA_DATABASE_URL=sqlite:///./database/cattleya.db
# Supabase / PostgreSQL (ver README seccion "Desplegar en Vercel + Supabase"):
# usa el "Connection pooling" (modo Transaction, puerto 6543) del panel de
# Supabase, no la conexion directa.
# CATTLEYA_DATABASE_URL=postgresql+psycopg://postgres.xxxx:clave@aws-0-xxxx.pooler.supabase.com:6543/postgres

# Proyecto de Supabase (CU-03, tiempo real). Panel de Supabase ->
# Project Settings -> Data API. La anon key es publica a proposito:
# Supabase la limita con Row Level Security, no con secreto.
CATTLEYA_SUPABASE_URL=
CATTLEYA_SUPABASE_ANON_KEY=

# Puerto del servidor. Se usa para armar la URL que llevan los codigos QR.
CATTLEYA_PUERTO=8000

# Direccion base que se incrusta en los codigos QR de las habitaciones.
# Si se deja vacia, se detecta la IP de la red local automaticamente
# (recomendado: asi los QR funcionan desde cualquier celular de la misma WiFi).
# Fijarla solo si el sistema se publica en un dominio real:
# CATTLEYA_BASE_URL=https://cattleya.hotel.com
CATTLEYA_BASE_URL=
